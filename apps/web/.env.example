# Database
DATABASE_URL=postgresql://postgres:***@localhost:5432/onehub

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-this-to-a-random-string

# Optional: public/canonical URL placeholders (local defaults only)
# Marlon must approve production domain, DNS, SSL, redirects, and auth callbacks before launch.
NEXT_PUBLIC_APP_URL=http://localhost:3000
ONEHUB_CANONICAL_URL=http://localhost:3000
ONEHUB_PRIMARY_DOMAIN=localhost

# Optional: production migration safety gate
# Set to true server-side during approved migration windows to freeze mutating API writes
# and redirect protected app pages to /maintenance. Do not expose as NEXT_PUBLIC_*.
ONEHUB_MAINTENANCE_MODE=false

# Optional: launch readiness / local-only observability placeholders
# Leave disabled locally unless explicitly testing. Do not paste production DSNs or secrets here.
ERROR_TRACKING_PROVIDER=console
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
ONEHUB_ERROR_LOG_SAMPLE_RATE=0

# Optional: local in-memory rate limiting placeholders
# Production Redis-backed limits require separate approval/provisioning before launch.
RATE_LIMIT_ENABLED=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_TRUST_PROXY=false

# Optional: OAuth (Google)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional: Stripe (payments)
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# OpenAI (for AI-powered proposals and contracts)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
