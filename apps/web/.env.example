# Database
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxx.supabase.co:5432/postgres

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-this-to-a-random-string

# Optional: OAuth (Google)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional: Stripe (payments)
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# OpenAI (for AI-powered proposals and contracts)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: Outbound email delivery (choose one provider; leave blank to disable sending)
# ONEHUB_EMAIL_PROVIDER=RESEND # RESEND, SENDGRID, POSTMARK, MAILGUN
# OUTBOUND_EMAIL_FROM=no-reply@example.com
# RESEND_API_KEY=
# SENDGRID_API_KEY=
# POSTMARK_SERVER_TOKEN=
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=

# Optional: Outbound SMS delivery (leave blank to disable sending)
# ONEHUB_SMS_PROVIDER=TWILIO
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_PHONE=
